+      // Marquer le segment du vantail (center -> leafEnd) comme consommé pour ne pas le signaler en orphelin
+      for (let si = 0; si < remainingSegs.length; si++) {
+        const s = remainingSegs[si];
+        const d1 = Math.hypot(s.x1 - center[0], s.z1 - center[1]) + Math.hypot(s.x2 - leafEnd[0], s.z2 - leafEnd[1]);
