+    return {
+      ok: true,
+      needsScaleConfirmation: !scaleConfirmed,
+      scaleConfirmed,
+      scaleProposal,
+      ptsPerMeter: activePtsPerMeter,
+      walls: wallRes.walls,
+      doors: doorRes.doors,
+      windows: winRes.windows,
+      rooms: roomRes.rooms,
+      toVerify,
+      stats: {
+        rawSegments: parsed.segments.length,
+        rawCurves: parsed.curves.length,
+        walls: wallRes.walls.length,
+        doors: doorRes.doors.length,
+        windows: winRes.windows.length,
+        rooms: roomRes.rooms.length,
+        toVerify: toVerify.length
+      }
+    };
+  }
+
+  /**
+   * Fusionne d'éventuelles annotations IA sur une extraction vectorielle :
+   * l'IA peut uniquement nommer/compléter les pièces ou annoter `toVerify`, JAMAIS déplacer,
+   * redimensionner ou supprimer un mur vectoriel.
+   */
+  function mergeAiAnnotations(vectorResult, aiAnnotations = {}) {
+    if (!vectorResult) return vectorResult;
+    const immutableWalls = JSON.parse(JSON.stringify(vectorResult.walls || []));
+    const rooms = JSON.parse(JSON.stringify(vectorResult.rooms || []));
+    const aiRooms = Array.isArray(aiAnnotations?.rooms) ? aiAnnotations.rooms : [];
+
+    for (const aiRoom of aiRooms) {
+      if (!aiRoom || !aiRoom.name) continue;
+      const match = rooms.find(r => r.id === aiRoom.id)
+        || (Array.isArray(aiRoom.center) && rooms.find(r => r.center && Math.hypot(r.center[0] - aiRoom.center[0], r.center[1] - aiRoom.center[1]) < 1.5));
