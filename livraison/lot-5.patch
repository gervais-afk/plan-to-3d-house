+    const dx = x2 - x1, dz = z2 - z1;
+    const len = Math.hypot(dx, dz);
+    const nx = (-dz / len) * (thick / 2);
+    const nz = (dx / len) * (thick / 2);
+    addLine(x1 + nx, z1 + nz, x2 + nx, z2 + nz);
+    addLine(x1 - nx, z1 - nz, x2 - nx, z2 - nz);
+  };
+
