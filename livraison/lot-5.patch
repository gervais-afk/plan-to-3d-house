+      // Côté d'ouverture par rapport à la normale du mur
+      const cross = (leafEnd[0] - center[0]) * host.uz - (leafEnd[1] - center[1]) * host.ux;
+      const side = cross >= 0 ? 1 : -1;
+      const opening = {
+        type: 'door',
+        level: 0,
+        at: r3(host.at),
+        w: r3(radius),
+        h: 2.1,
+        sill: 0,
+        hinge: 'start',
+        side,
+        provenance: 'vector'
+      };
+      host.wall.openings.push(opening);
+      doors.push({ wallIndex: host.wallIndex, ...opening, hingePos: [r3(center[0]), r3(center[1])] });
