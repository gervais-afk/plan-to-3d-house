+    return extract({
+      operatorList,
+      textContent,
+      pageHeightPt: vp ? vp.height : options.pageHeightPt,
+      ops,
+      confirmedScale: options.confirmedScale,
+      ptsPerMeter: options.ptsPerMeter
+    });
+  }
+
+  return {
+    DEFAULT_OPS,
+    PT_PER_METER_1_1,
+    ptsPerMeterForDenominator,
+    detectScaleProposal,
+    confirmScale,
+    parseOperatorList,
+    extract,
+    extractFromPdfPage,
+    mergeAiAnnotations
+  };
+})();
+
+if (typeof module !== 'undefined') module.exports = PdfVectorExtract;
