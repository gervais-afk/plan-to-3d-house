+const PdfVectorExtract = require('../js/pdfVectorExtract');
+
+const OPS = PdfVectorExtract.DEFAULT_OPS;
+
+function buildSynthetic3RoomHousePdf() {
+  // Échelle 1/100 : 1 m réel = 28.3464567 pt PDF
