+/**
+ * LECTURE VECTORIELLE DES PDF D'ARCHITECTE (module pur, déterministe, sans réseau)
+ *
+ * Analyse directement les flux PDF.js (`getOperatorList()` + `getTextContent()`) pour extraire :
+ *  - les murs (paires de traits parallèles distants de 0,08 à 0,40 m) ;
+ *  - les portes (arcs de battement en quart de cercle) ;
+ *  - les fenêtres (traits de menuiserie parallèles serrés dans l'axe d'un mur ou d'une baie) ;
+ *  - les textes des pièces (noms et surfaces éventuelles) ;
+ *  - la proposition d'échelle lue dans le cartouche (JAMAIS appliquée silencieusement sans confirmation).
+ *
+ * Principe directeur : rien n'est deviné ni supprimé en silence. Tout segment, arc ou texte non
+ * interprété avec certitude est consigné dans `toVerify` (« À vérifier ») avec ses coordonnées.
+ * L'IA, si elle est appelée ensuite (`mergeAiAnnotations`), ne peut que nommer les pièces ou lever
+ * des ambiguïtés — jamais déplacer un mur vectoriel.
+ */
+const PdfVectorExtract = (() => {
+  // Codes d'opérateurs PDF.js (compatibles PDF.js 3.x / 4.x)
+  const DEFAULT_OPS = {
+    save: 10,
+    restore: 11,
+    transform: 12,
+    moveTo: 13,
+    lineTo: 14,
+    curveTo: 15,
+    curveTo2: 16,
+    curveTo3: 17,
+    closePath: 18,
+    rectangle: 19,
+    stroke: 20,
+    closeStroke: 21,
+    fill: 22,
+    eoFill: 23,
+    fillStroke: 24,
+    eoFillStroke: 25,
+    closeFillStroke: 26,
+    closeEOFillStroke: 27,
+    endPath: 28,
+    constructPath: 91
+  };
+
+  const PT_PER_METER_1_1 = 72 / 0.0254; // 2834.645669... points PDF par mètre réel au 1:1
+  const WALL_MIN_THICK = 0.08;
+  const WALL_MAX_THICK = 0.40;
+  const WALL_MIN_LEN = 0.25;
+  const DOOR_MIN_RADIUS = 0.55;
+  const DOOR_MAX_RADIUS = 1.35;
+  const WINDOW_MIN_GAP = 0.012;
+  const WINDOW_MAX_GAP = 0.075;
+  const WINDOW_MIN_LEN = 0.40;
+  const WINDOW_MAX_LEN = 5.0;
+
+  const r3 = v => Math.round(v * 1000) / 1000;
+  const r2 = v => Math.round(v * 100) / 100;
+
+  function multiplyMatrix(m1, m2) {
+    return [
+      m1[0] * m2[0] + m1[2] * m2[1],
+      m1[1] * m2[0] + m1[3] * m2[1],
+      m1[0] * m2[2] + m1[2] * m2[3],
+      m1[1] * m2[2] + m1[3] * m2[3],
+      m1[0] * m2[4] + m1[2] * m2[5] + m1[4],
+      m1[1] * m2[4] + m1[3] * m2[5] + m1[5]
+    ];
+  }
+
+  function applyMatrix(m, x, y) {
+    return [m[0] * x + m[2] * y + m[4], m[1] * x + m[3] * y + m[5]];
+  }
+
+  function ptsPerMeterForDenominator(denominator) {
+    const d = Number(denominator);
+    if (!Number.isFinite(d) || d <= 0) return null;
+    return PT_PER_METER_1_1 / d;
+  }
+
+  /**
+   * Détecte une échelle inscrite dans le texte du PDF (ex. « Échelle 1/100 », « 1:50 »).
+   * Retourne uniquement une PROPOSITION (`confirmed: false`), jamais validée automatiquement.
+   */
+  function detectScaleProposal(textItems = []) {
+    const joined = textItems.map(t => String(t?.str || '')).join(' ');
+    const explicit = joined.match(/(?:ech(?:elle)?|éch(?:elle)?|scale|ec\.?)\s*[:=]?\s*1\s*[:/]\s*(\d{2,4})\b/i);
+    const bare = !explicit ? joined.match(/\b1\s*[:/]\s*(20|25|50|75|100|125|150|200|250|500)\b/) : null;
+    const match = explicit || bare;
+    if (!match) return null;
+    const denominator = Number(match[1]);
+    if (!Number.isFinite(denominator) || denominator < 5 || denominator > 5000) return null;
+    return {
+      denominator,
+      label: `1/${denominator}`,
+      ptsPerMeter: ptsPerMeterForDenominator(denominator),
+      confirmed: false,
+      source: explicit ? 'cartouche' : 'texte'
+    };
+  }
+
+  /**
+   * Confirme une échelle proposée contre une cote témoin mesurée sur le PDF.
+   * Si l'écart dépasse 2 %, l'échelle du cartouche est signalée incohérente et la cote témoin prévaut
+   * (avec avertissement explicite).
+   */
+  function confirmScale({ detectedDenominator = null, witnessPdfPoints, witnessRealMeters, tolerance = 0.02 } = {}) {
+    const pts = Number(witnessPdfPoints);
+    const real = Number(witnessRealMeters);
+    if (!Number.isFinite(pts) || pts <= 0 || !Number.isFinite(real) || real <= 0) {
+      throw new Error('Une cote témoin valide (distance PDF en points et longueur réelle en mètres) est requise.');
+    }
+    const measuredPtsPerMeter = pts / real;
+    const measuredDenominator = PT_PER_METER_1_1 / measuredPtsPerMeter;
+    let consistent = true;
+    let relativeError = 0;
+    let warning = '';
+    if (Number.isFinite(Number(detectedDenominator)) && Number(detectedDenominator) > 0) {
+      const expectedPtsPerMeter = ptsPerMeterForDenominator(detectedDenominator);
+      relativeError = Math.abs(measuredPtsPerMeter - expectedPtsPerMeter) / expectedPtsPerMeter;
+      consistent = relativeError <= tolerance;
+      if (!consistent) {
+        warning = `Écart de ${(relativeError * 100).toFixed(1)} % entre l’échelle 1/${detectedDenominator} du cartouche et la cote témoin (${real} m).`;
+      }
+    }
+    return {
+      confirmed: true,
+      ptsPerMeter: measuredPtsPerMeter,
+      denominator: Math.round(measuredDenominator * 10) / 10,
+      detectedDenominator: detectedDenominator ? Number(detectedDenominator) : null,
+      consistent,
+      relativeError: Math.round(relativeError * 10000) / 10000,
+      warning
+    };
+  }
+
+  /**
+   * Parcourt un operatorList PDF.js (`{ fnArray, argsArray }`) et retourne les primitives géométriques
+   * (segments droits et courbes de Bézier cubiques) en coordonnées PDF (points).
+   */
+  function parseOperatorList(operatorList, ops = DEFAULT_OPS) {
+    const OPS = { ...DEFAULT_OPS, ...(ops || {}) };
+    const fnArray = operatorList?.fnArray || [];
+    const argsArray = operatorList?.argsArray || [];
+    const segments = [];
+    const curves = [];
+
+    let ctm = [1, 0, 0, 1, 0, 0];
+    const stack = [];
+    let cur = null;
+    let subStart = null;
+    let pendingSegs = [];
+    let pendingCurves = [];
+
+    const flush = () => {
+      if (pendingSegs.length) segments.push(...pendingSegs);
+      if (pendingCurves.length) curves.push(...pendingCurves);
+      pendingSegs = [];
+      pendingCurves = [];
+      cur = null;
+      subStart = null;
+    };
+    const clear = () => {
+      pendingSegs = [];
+      pendingCurves = [];
+      cur = null;
+      subStart = null;
+    };
+
+    const pushSeg = (p1, p2) => {
+      if (Math.hypot(p2[0] - p1[0], p2[1] - p1[1]) > 1e-3) {
+        pendingSegs.push({ x1: p1[0], y1: p1[1], x2: p2[0], y2: p2[1] });
+      }
+    };
+
+    const execPathOp = (op, args) => {
+      if (op === OPS.moveTo) {
+        const pt = applyMatrix(ctm, args[0], args[1]);
+        cur = pt;
+        subStart = pt;
+      } else if (op === OPS.lineTo) {
+        const pt = applyMatrix(ctm, args[0], args[1]);
+        if (cur) pushSeg(cur, pt);
+        cur = pt;
+      } else if (op === OPS.curveTo) {
+        const p1 = applyMatrix(ctm, args[0], args[1]);
+        const p2 = applyMatrix(ctm, args[2], args[3]);
+        const p3 = applyMatrix(ctm, args[4], args[5]);
+        if (cur) pendingCurves.push({ p0: cur, p1, p2, p3 });
+        cur = p3;
+      } else if (op === OPS.curveTo2) {
+        const p2 = applyMatrix(ctm, args[0], args[1]);
+        const p3 = applyMatrix(ctm, args[2], args[3]);
+        if (cur) pendingCurves.push({ p0: cur, p1: cur, p2, p3 });
+        cur = p3;
+      } else if (op === OPS.curveTo3) {
+        const p1 = applyMatrix(ctm, args[0], args[1]);
+        const p3 = applyMatrix(ctm, args[2], args[3]);
+        if (cur) pendingCurves.push({ p0: cur, p1, p2: p3, p3 });
+        cur = p3;
+      } else if (op === OPS.closePath) {
+        if (cur && subStart) pushSeg(cur, subStart);
+        cur = subStart;
+      } else if (op === OPS.rectangle) {
+        const [x, y, w, h] = args;
+        const a = applyMatrix(ctm, x, y);
+        const b = applyMatrix(ctm, x + w, y);
+        const c = applyMatrix(ctm, x + w, y + h);
+        const d = applyMatrix(ctm, x, y + h);
+        pushSeg(a, b); pushSeg(b, c); pushSeg(c, d); pushSeg(d, a);
+        cur = a; subStart = a;
+      }
+    };
+
+    for (let i = 0; i < fnArray.length; i++) {
+      const fn = fnArray[i];
+      const args = argsArray[i] || [];
+      if (fn === OPS.save) {
+        stack.push(ctm.slice());
+      } else if (fn === OPS.restore) {
+        ctm = stack.pop() || [1, 0, 0, 1, 0, 0];
+      } else if (fn === OPS.transform) {
+        ctm = multiplyMatrix(ctm, args);
+      } else if (fn === OPS.constructPath) {
+        const subOps = args[0] || [];
+        const flat = args[1] || [];
+        let k = 0;
+        for (const sub of subOps) {
+          if (sub === OPS.moveTo || sub === OPS.lineTo) {
+            execPathOp(sub, [flat[k], flat[k + 1]]); k += 2;
+          } else if (sub === OPS.curveTo) {
+            execPathOp(sub, [flat[k], flat[k + 1], flat[k + 2], flat[k + 3], flat[k + 4], flat[k + 5]]); k += 6;
+          } else if (sub === OPS.curveTo2 || sub === OPS.curveTo3) {
+            execPathOp(sub, [flat[k], flat[k + 1], flat[k + 2], flat[k + 3]]); k += 4;
+          } else if (sub === OPS.rectangle) {
+            execPathOp(sub, [flat[k], flat[k + 1], flat[k + 2], flat[k + 3]]); k += 4;
+          } else if (sub === OPS.closePath) {
+            execPathOp(sub, []);
+          }
+        }
+      } else if (
+        fn === OPS.moveTo || fn === OPS.lineTo || fn === OPS.curveTo ||
+        fn === OPS.curveTo2 || fn === OPS.curveTo3 || fn === OPS.closePath || fn === OPS.rectangle
+      ) {
+        execPathOp(fn, args);
+      } else if (fn === OPS.closeStroke || fn === OPS.closeFillStroke || fn === OPS.closeEOFillStroke) {
+        execPathOp(OPS.closePath, []);
+        flush();
+      } else if (fn === OPS.stroke || fn === OPS.fill || fn === OPS.eoFill || fn === OPS.fillStroke || fn === OPS.eoFillStroke) {
+        flush();
+      } else if (fn === OPS.endPath) {
+        clear();
+      }
+    }
+    // Certains générateurs laissent un chemin sans opérateur stroke final dans un flux minimal
+    if (pendingSegs.length || pendingCurves.length) flush();
+
+    return { segments, curves };
+  }
+
+  function segInfo(s) {
+    const dx = s.x2 - s.x1;
+    const dz = s.z2 - s.z1;
+    const len = Math.hypot(dx, dz);
+    if (len < 1e-6) return null;
+    // Direction canonique (toujours dans le demi-plan angle in [0, pi))
+    let ux = dx / len, uz = dz / len;
+    if (ux < -1e-6 || (Math.abs(ux) <= 1e-6 && uz < 0)) { ux = -ux; uz = -uz; }
+    const nx = -uz, nz = ux;
+    const t1 = s.x1 * ux + s.z1 * uz;
+    const t2 = s.x2 * ux + s.z2 * uz;
+    const offset = s.x1 * nx + s.z1 * nz;
+    return {
+      ...s,
+      len,
+      ux,
+      uz,
+      nx,
+      nz,
+      tMin: Math.min(t1, t2),
+      tMax: Math.max(t1, t2),
+      offset
+    };
+  }
+
+  /** Détecte les murs comme paires de segments parallèles espacés de 0,08 à 0,40 m. */
+  function detectWalls(rawSegments) {
+    const segs = rawSegments.map(segInfo).filter(s => s && s.len >= 0.05);
+    const used = new Set();
+    const candidates = [];
+
+    for (let i = 0; i < segs.length; i++) {
+      for (let j = i + 1; j < segs.length; j++) {
+        const a = segs[i], b = segs[j];
+        const dot = Math.abs(a.ux * b.ux + a.uz * b.uz);
+        if (dot < 0.996) continue; // ~5° max
+        const sep = Math.abs(a.offset - b.offset);
+        if (sep < WALL_MIN_THICK - 1e-4 || sep > WALL_MAX_THICK + 1e-4) continue;
+        const ovMin = Math.max(a.tMin, b.tMin);
+        const ovMax = Math.min(a.tMax, b.tMax);
+        const overlap = ovMax - ovMin;
+        if (overlap < WALL_MIN_LEN) continue;
+        candidates.push({ i, j, sep, ovMin, ovMax, overlap, score: overlap - sep * 0.25 });
+      }
+    }
+
+    candidates.sort((a, b) => b.score - a.score);
+    const walls = [];
+    for (const c of candidates) {
+      if (used.has(c.i) || used.has(c.j)) continue;
+      const a = segs[c.i], b = segs[c.j];
+      used.add(c.i);
+      used.add(c.j);
+      const midOff = (a.offset + b.offset) / 2;
+      const from = [r3(a.ux * c.ovMin + a.nx * midOff), r3(a.uz * c.ovMin + a.nz * midOff)];
+      const to = [r3(a.ux * c.ovMax + a.nx * midOff), r3(a.uz * c.ovMax + a.nz * midOff)];
+      const thick = r3(c.sep);
+      walls.push({
+        from,
+        to,
+        thick,
+        type: thick >= 0.18 ? 'ext' : 'int',
+        level: 0,
+        openings: [],
+        provenance: 'vector',
+        locked: true
+      });
+    }
+
+    // Marquer aussi les petits traits de fermeture d'extrémité de mur (bouchons de longueur ~thick)
+    for (let i = 0; i < segs.length; i++) {
+      if (used.has(i)) continue;
+      const s = segs[i];
+      if (s.len > WALL_MAX_THICK + 0.05) continue;
+      const mx = (s.x1 + s.x2) / 2, mz = (s.z1 + s.z2) / 2;
+      const touchesWallEnd = walls.some(w => {
+        const dFrom = Math.hypot(mx - w.from[0], mz - w.from[1]);
+        const dTo = Math.hypot(mx - w.to[0], mz - w.to[1]);
+        return Math.min(dFrom, dTo) <= w.thick * 0.8 + 0.05;
+      });
+      if (touchesWallEnd) used.add(i);
+    }
+
+    const remaining = segs.filter((_s, idx) => !used.has(idx));
+    return { walls, remaining };
+  }
+
+  /** Détecte les fenêtres : faisceaux de traits parallèles serrés (0,012–0,075 m) dans ou contre un mur. */
+  function detectWindows(remainingSegs, walls) {
+    const used = new Set();
+    const windows = [];
+
+    // Grouper les segments parallèles très proches (menuiserie de fenêtre : 2 ou 3 traits parallèles)
+    for (let i = 0; i < remainingSegs.length; i++) {
+      if (used.has(i)) continue;
+      const a = remainingSegs[i];
+      if (a.len < WINDOW_MIN_LEN || a.len > WINDOW_MAX_LEN) continue;
+      const group = [i];
+      for (let j = i + 1; j < remainingSegs.length; j++) {
+        if (used.has(j)) continue;
+        const b = remainingSegs[j];
+        if (Math.abs(a.ux * b.ux + a.uz * b.uz) < 0.996) continue;
+        const sep = Math.abs(a.offset - b.offset);
+        if (sep < WINDOW_MIN_GAP || sep > WINDOW_MAX_GAP) continue;
+        const ov = Math.min(a.tMax, b.tMax) - Math.max(a.tMin, b.tMin);
+        if (ov < Math.min(a.len, b.len) * 0.7) continue;
+        group.push(j);
+      }
+      if (group.length < 2) continue;
+
+      // Calcul du centre et de la largeur de la fenêtre
+      const members = group.map(idx => remainingSegs[idx]);
+      const tMin = Math.min(...members.map(m => m.tMin));
+      const tMax = Math.max(...members.map(m => m.tMax));
+      const midOff = members.reduce((acc, m) => acc + m.offset, 0) / members.length;
+      const width = tMax - tMin;
+      const midT = (tMin + tMax) / 2;
+      const cx = a.ux * midT + a.nx * midOff;
+      const cz = a.uz * midT + a.nz * midOff;
+
+      // Rattachement au mur colinéaire ou hôte le plus proche
+      const host = findHostWall(walls, cx, cz, a.ux, a.uz, 0.35);
+      if (host) {
+        group.forEach(idx => used.add(idx));
+        const opening = {
+          type: 'window',
+          level: 0,
+          at: r3(host.at),
+          w: r3(width),
+          h: 1.25,
+          sill: 0.9,
+          provenance: 'vector'
+        };
+        host.wall.openings.push(opening);
+        windows.push({ wallIndex: host.wallIndex, ...opening, center: [r3(cx), r3(cz)] });
+      }
+    }
+
+    const leftovers = remainingSegs.filter((_s, idx) => !used.has(idx));
+    return { windows, remaining: leftovers };
+  }
+
+  function findHostWall(walls, cx, cz, dirX, dirZ, maxDist = 0.35) {
+    let best = null;
+    for (let wi = 0; wi < walls.length; wi++) {
+      const w = walls[wi];
+      const dx = w.to[0] - w.from[0];
+      const dz = w.to[1] - w.from[1];
+      const len = Math.hypot(dx, dz);
+      if (len < 1e-4) continue;
+      const ux = dx / len, uz = dz / len;
+      if (dirX !== null && dirZ !== null && Math.abs(ux * dirX + uz * dirZ) < 0.95) continue;
+      const rx = cx - w.from[0], rz = cz - w.from[1];
+      const proj = rx * ux + rz * uz;
+      const perp = Math.abs(-rx * uz + rz * ux);
+      if (proj < -0.15 || proj > len + 0.15) continue;
+      if (perp > maxDist) continue;
+      if (!best || perp < best.dist) {
+        best = { wall: w, wallIndex: wi, at: Math.max(0, Math.min(len, proj)), dist: perp, len, ux, uz };
+      }
+    }
+    return best;
+  }
+
+  /**
+   * Détecte les portes à partir des courbes de Bézier cubiques (arcs de quart de cercle).
+   * Un arc de porte typique de rayon R a une corde ~ R*sqrt(2) et des tangentes aux extrémités
+   * approximativement perpendiculaires.
+   */
+  function detectDoors(curves, walls, remainingSegs) {
+    const doors = [];
+    const unmatchedCurves = [];
+    const consumedSegIndices = new Set();
+
+    for (const c of curves) {
+      const t0x = c.p1[0] - c.p0[0], t0z = c.p1[1] - c.p0[1];
+      const t1x = c.p3[0] - c.p2[0], t1z = c.p3[1] - c.p2[1];
+      const l0 = Math.hypot(t0x, t0z), l1 = Math.hypot(t1x, t1z);
+      const chord = Math.hypot(c.p3[0] - c.p0[0], c.p3[1] - c.p0[1]);
+      if (l0 < 0.05 || l1 < 0.05 || chord < DOOR_MIN_RADIUS) {
+        unmatchedCurves.push({ curve: c, reason: 'Courbe trop courte ou dégénérée' });
+        continue;
+      }
+      const cosAngle = (t0x * t1x + t0z * t1z) / (l0 * l1);
+      // Pour un quart de cercle, l'angle entre tangente début et tangente fin est ~90° (|cos| < 0.35)
+      if (Math.abs(cosAngle) > 0.35) {
+        unmatchedCurves.push({ curve: c, reason: 'Courbe non orthogonale (pas un arc de porte 90°)' });
+        continue;
+      }
+      const radius = chord / Math.SQRT2;
+      if (radius < DOOR_MIN_RADIUS || radius > DOOR_MAX_RADIUS) {
+        unmatchedCurves.push({ curve: c, reason: `Rayon d'arc hors plage porte (${r2(radius)} m)` });
+        continue;
+      }
+
+      // Les deux centres possibles du quart de cercle sont les intersections des normales aux extrémités.
+      // Pour un quart de cercle, le centre O vérifie O = p0 + R * n0 = p3 + R * n1.
+      const u0x = t0x / l0, u0z = t0z / l0;
+      const u1x = t1x / l1, u1z = t1z / l1;
+      // Le centre est du côté concave : O ≈ p0 + radius * u1 (car la tangente finale est parallèle au rayon initial)
+      const candA = [c.p0[0] - radius * u1x, c.p0[1] - radius * u1z];
+      const candB = [c.p0[0] + radius * u1x, c.p0[1] + radius * u1z];
+      const center = Math.abs(Math.hypot(candA[0] - c.p3[0], candA[1] - c.p3[1]) - radius) <
+        Math.abs(Math.hypot(candB[0] - c.p3[0], candB[1] - c.p3[1]) - radius) ? candA : candB;
+
+      // Chercher quel rayon (center -> p0 ou center -> p3) est dans l'axe d'un mur hôte :
+      // le point sur le mur donne la position de la baie, l'autre donne le vantail ouvert.
+      const midA = [(center[0] + c.p0[0]) / 2, (center[1] + c.p0[1]) / 2];
+      const dirA = [(c.p0[0] - center[0]) / radius, (c.p0[1] - center[1]) / radius];
+      const midB = [(center[0] + c.p3[0]) / 2, (center[1] + c.p3[1]) / 2];
+      const dirB = [(c.p3[0] - center[0]) / radius, (c.p3[1] - center[1]) / radius];
+
+      const hostA = findHostWall(walls, midA[0], midA[1], dirA[0], dirA[1], 0.40);
+      const hostB = findHostWall(walls, midB[0], midB[1], dirB[0], dirB[1], 0.40);
+      let host = null;
+      let leafEnd = null;
+      if (hostA && (!hostB || hostA.dist <= hostB.dist)) {
+        host = hostA; leafEnd = c.p3;
+      } else if (hostB) {
+        host = hostB; leafEnd = c.p0;
+      } else {
