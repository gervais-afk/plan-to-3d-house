+    // Associer les étiquettes de surface séparées (« 24,5 m² ») à la pièce la plus proche (< 2,5 m)
+    for (const areaTok of areaTokens) {
+      let nearest = null;
+      let bestDist = Infinity;
+      for (const room of rooms) {
+        const d = Math.hypot(areaTok.x - room.center[0], areaTok.z - room.center[1]);
+        if (d < bestDist && d <= 2.5) { bestDist = d; nearest = room; }
+      }
+      const val = Number((areaTok.str.match(AREA_RE) || [])[1]?.replace(',', '.'));
+      if (nearest && Number.isFinite(val)) {
+        nearest.declaredArea = val;
+        if (!nearest.area) nearest.area = val;
+      } else {
+        unmatchedTexts.push(areaTok);
+      }
+    }
