+    return {
+      ...vectorResult,
+      walls: immutableWalls,
+      rooms
+    };
+  }
+
+  /**
+   * Extrait directement depuis un objet PDFPageProxy PDF.js (`page.getOperatorList()` + `page.getTextContent()`).
+   */
+  async function extractFromPdfPage(pdfPage, options = {}) {
+    const [operatorList, textContent] = await Promise.all([
+      pdfPage.getOperatorList(),
+      pdfPage.getTextContent().catch(() => ({ items: [] }))
+    ]);
+    const vp = typeof pdfPage.getViewport === 'function' ? pdfPage.getViewport({ scale: 1 }) : null;
