+    return { doors, unmatchedCurves, remaining: leftovers };
+  }
+
+  const ROOM_HINT_RE = /\b(sejour|séjour|salon|chambre|cuisine|sdb|salle\s*(?:de\s*bain|d['’]eau|a\s*manger|à\s*manger)|wc|toilette|bureau|dressing|veranda|véranda|terrasse|entree|entrée|hall|degagement|dégagement|couloir|garage|buanderie|cellier|palier|repas)\b/i;
+  const AREA_RE = /(\d+[,.]\d+|\d+)\s*m\s*(?:2|²)/i;
+  const CARTOUCHE_RE = /\b(titre|echelle|échelle|projet|maitre|maître|indice|date|format|plan\s+de)\b/i;
+
+  function guessFloorType(name) {
+    const n = String(name || '').toLowerCase();
+    if (/terrasse|veranda|véranda|balcon/.test(n)) return 'stone';
+    if (/cuisine|sdb|bain|eau|wc|toilette|buanderie|garage/.test(n)) return 'tile';
+    if (/chambre|bureau|dressing/.test(n)) return 'parquet';
+    return 'tiles';
+  }
+
+  function slugRoomId(name, idx) {
+    const base = String(name || `piece-${idx + 1}`)
+      .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
+      .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
+    return base || `piece-${idx + 1}`;
+  }
+
+  /**
+   * Calcule les cellules rectangulaires formées par les murs (grille H/V) afin d'associer chaque
+   * texte de pièce à une emprise cohérente.
+   */
+  function estimateRoomBounds(cx, cz, walls) {
+    let xMin = -Infinity, xMax = Infinity, zMin = -Infinity, zMax = Infinity;
+    for (const w of walls) {
+      const dx = Math.abs(w.to[0] - w.from[0]);
+      const dz = Math.abs(w.to[1] - w.from[1]);
+      if (dx < 0.08 && dz >= 0.3) {
+        // Mur vertical à x = wx
+        const wx = (w.from[0] + w.to[0]) / 2;
+        const wz0 = Math.min(w.from[1], w.to[1]) - 0.2;
+        const wz1 = Math.max(w.from[1], w.to[1]) + 0.2;
+        if (cz >= wz0 && cz <= wz1) {
+          if (wx < cx && wx > xMin) xMin = wx;
+          if (wx > cx && wx < xMax) xMax = wx;
+        }
+      } else if (dz < 0.08 && dx >= 0.3) {
+        // Mur horizontal à z = wz
+        const wz = (w.from[1] + w.to[1]) / 2;
+        const wx0 = Math.min(w.from[0], w.to[0]) - 0.2;
+        const wx1 = Math.max(w.from[0], w.to[0]) + 0.2;
+        if (cx >= wx0 && cx <= wx1) {
+          if (wz < cz && wz > zMin) zMin = wz;
+          if (wz > cz && wz < zMax) zMax = wz;
+        }
+      }
+    }
+    if (isFinite(xMin) && isFinite(xMax) && isFinite(zMin) && isFinite(zMax) && xMax > xMin + 0.4 && zMax > zMin + 0.4) {
+      return { xMin: r3(xMin), xMax: r3(xMax), zMin: r3(zMin), zMax: r3(zMax) };
+    }
+    return null;
+  }
+
+  function extractRoomsFromText(textItems, walls, toPlanCoords) {
+    const positioned = [];
+    for (const item of (textItems || [])) {
+      const str = String(item?.str || '').trim();
+      if (!str) continue;
+      const tr = Array.isArray(item.transform) && item.transform.length >= 6 ? item.transform : [1, 0, 0, 1, 0, 0];
+      const [x, z] = toPlanCoords(tr[4], tr[5]);
+      positioned.push({ str, x: r3(x), z: r3(z) });
+    }
+
+    const rooms = [];
+    const unmatchedTexts = [];
+    const areaTokens = [];
+
+    for (const tok of positioned) {
+      if (AREA_RE.test(tok.str) && !ROOM_HINT_RE.test(tok.str)) {
+        areaTokens.push(tok);
+        continue;
+      }
+      if (CARTOUCHE_RE.test(tok.str) || /^1\s*[:/]\s*\d{2,4}$/.test(tok.str)) continue;
+      const bounds = estimateRoomBounds(tok.x, tok.z, walls);
+      if (ROOM_HINT_RE.test(tok.str) || bounds) {
+        const areaMatch = tok.str.match(AREA_RE);
+        const cleanName = tok.str.replace(AREA_RE, '').trim() || tok.str;
+        const declaredArea = areaMatch ? Number(areaMatch[1].replace(',', '.')) : null;
+        const areaFromBounds = bounds ? r2((bounds.xMax - bounds.xMin) * (bounds.zMax - bounds.zMin)) : null;
+        rooms.push({
+          id: slugRoomId(cleanName, rooms.length),
+          name: cleanName,
+          level: 0,
+          center: [tok.x, tok.z],
+          bounds,
+          area: declaredArea ?? areaFromBounds,
+          declaredArea,
+          floorType: guessFloorType(cleanName),
+          habitable: !/terrasse|veranda|véranda|garage|balcon/i.test(cleanName),
+          provenance: 'vector'
+        });
+      } else {
+        unmatchedTexts.push(tok);
+      }
+    }
