+      if (seg.len < 0.20) continue; // micro-traits de hachure ou jonction
+      toVerify.push({
+        kind: 'segment',
+        reason: `Trait vectoriel non interprété (${r2(seg.len)} m)`,
+        coords: { from: [r3(seg.x1), r3(seg.z1)], to: [r3(seg.x2), r3(seg.z2)] }
+      });
+    }
+    for (const uc of doorRes.unmatchedCurves) {
+      toVerify.push({
+        kind: 'curve',
+        reason: uc.reason,
+        coords: { from: [r3(uc.curve.p0[0]), r3(uc.curve.p0[1])], to: [r3(uc.curve.p3[0]), r3(uc.curve.p3[1])] }
+      });
+    }
+    for (const ut of roomRes.unmatchedTexts) {
+      toVerify.push({
+        kind: 'text',
+        reason: `Texte non rattaché à une pièce : « ${ut.str} »`,
+        coords: { at: [ut.x, ut.z] }
+      });
+    }
