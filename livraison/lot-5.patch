+    const parsed = parseOperatorList(operatorList, ops);
+    const hPt = Number.isFinite(Number(pageHeightPt)) ? Number(pageHeightPt) : 0;
+    const toPlanCoords = (xPt, yPt) => [
+      xPt / activePtsPerMeter,
+      (hPt ? (hPt - yPt) : -yPt) / activePtsPerMeter
+    ];
+
+    const planSegments = parsed.segments.map(s => {
+      const [x1, z1] = toPlanCoords(s.x1, s.y1);
+      const [x2, z2] = toPlanCoords(s.x2, s.y2);
+      return { x1, z1, x2, z2 };
+    });
+    const planCurves = parsed.curves.map(c => ({
+      p0: toPlanCoords(c.p0[0], c.p0[1]),
+      p1: toPlanCoords(c.p1[0], c.p1[1]),
+      p2: toPlanCoords(c.p2[0], c.p2[1]),
+      p3: toPlanCoords(c.p3[0], c.p3[1])
+    }));
+
+    const wallRes = detectWalls(planSegments);
+    const winRes = detectWindows(wallRes.remaining, wallRes.walls);
+    const doorRes = detectDoors(planCurves, wallRes.walls, winRes.remaining);
+    const roomRes = extractRoomsFromText(textItems, wallRes.walls, toPlanCoords);
+
+    // Trier les ouvertures par position `at` sur chaque mur
+    for (const w of wallRes.walls) {
+      w.openings.sort((a, b) => a.at - b.at);
+    }
+
+    // Tout élément non interprété est signalé dans « À vérifier » (jamais supprimé en silence)
