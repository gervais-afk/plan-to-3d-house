+    return { rooms, unmatchedTexts };
+  }
+
+  /**
+   * Extraction vectorielle complète d'une page PDF à partir de `operatorList` + `textContent`.
+   * @param {{ operatorList, textContent, pageHeightPt?, ops?, confirmedScale?, ptsPerMeter? }} input
+   */
+  function extract({ operatorList, textContent = { items: [] }, pageHeightPt = null, ops = DEFAULT_OPS, confirmedScale = null, ptsPerMeter = null } = {}) {
+    const textItems = Array.isArray(textContent) ? textContent : (textContent?.items || []);
+    const scaleProposal = detectScaleProposal(textItems);
+    const toVerify = [];
+
+    let activePtsPerMeter = null;
+    let scaleConfirmed = false;
+
+    if (confirmedScale && confirmedScale.confirmed && Number.isFinite(confirmedScale.ptsPerMeter) && confirmedScale.ptsPerMeter > 0) {
+      activePtsPerMeter = confirmedScale.ptsPerMeter;
+      scaleConfirmed = true;
+      if (confirmedScale.consistent === false && confirmedScale.warning) {
+        toVerify.push({ kind: 'scale', reason: confirmedScale.warning, coords: null });
+      }
+    } else if (Number.isFinite(Number(ptsPerMeter)) && Number(ptsPerMeter) > 0) {
+      activePtsPerMeter = Number(ptsPerMeter);
+      scaleConfirmed = true;
+    } else if (scaleProposal) {
+      activePtsPerMeter = scaleProposal.ptsPerMeter;
+      scaleConfirmed = false;
+      toVerify.push({
+        kind: 'scale',
+        reason: `Échelle ${scaleProposal.label} lue dans le document : à confirmer sur une cote témoin avant validation.`,
+        coords: null
+      });
+    } else {
+      // Aucune échelle ni confirmation : on refuse d'inventer une échelle arbitraire
+      return {
+        ok: false,
+        needsScaleConfirmation: true,
+        scaleConfirmed: false,
+        scaleProposal: null,
+        ptsPerMeter: null,
+        walls: [],
+        doors: [],
+        windows: [],
+        rooms: [],
+        toVerify: [{
+          kind: 'scale',
+          reason: 'Aucune échelle détectée ni confirmée : mesurez une cote témoin pour extraire la géométrie vectorielle.',
+          coords: null
+        }],
+        stats: { rawSegments: 0, rawCurves: 0, walls: 0, doors: 0, windows: 0, rooms: 0, toVerify: 1 }
+      };
+    }
