+    const [px1, py1] = toPdf(x1, z1);
+    const [px2, py2] = toPdf(x2, z2);
+    fnArray.push(OPS.moveTo, OPS.lineTo, OPS.stroke);
+    argsArray.push([px1, py1], [px2, py2], []);
+  };
+
+  // Helper mur : paire de traits parallèles séparés de `thick`
