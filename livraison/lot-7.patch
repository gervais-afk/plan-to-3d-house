+      function cleanup() {
+        confirmBtn.removeEventListener('click', onConfirm);
+        cancelBtn.removeEventListener('click', onCancel);
+        dialogEl.removeEventListener('cancel', onCancel);
+      }
+      function finish(val) {
+        if (settled) return;
+        settled = true;
+        cleanup();
+        if (typeof dialogEl.close === 'function' && dialogEl.open) dialogEl.close();
+        resolve(val);
+      }
+      function onCancel(e) {
